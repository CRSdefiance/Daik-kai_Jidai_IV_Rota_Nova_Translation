          "current_body_hex": "49276d206f6e6c7920676f696e6720746f207361792074686973206f6e63652e200a204c697374656e206361726566756c6c792e20",
          "Japanese": "１回しか言わないわよ\nちゃんと聞いて",
          "current_English": "I'm only going to say this once. \n Listen carefully. "
        },
        {
          "file_path": "/data/SC0.DK4",
          "block": 49,
          "source_command_offset": 720,
          "current_command_offset": 686,
