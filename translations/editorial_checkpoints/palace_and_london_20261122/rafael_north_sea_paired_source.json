          "current_command_offset": 704,
          "source_offset": 747,
          "current_offset": 709,
          "source_record_index": 82,
          "native_command_word": 16384,
          "selector": 2,
          "slots": [],
          "source_body_hex": "82a082cc82cb81418da182cd82cb814190a28a45928682c582a282eb82f182c80a906c82bd82bf82aa96d782af82e682a482c682aa82f182ce82c182c482e982ed82af82e60a82b182cc8a4388e682c582e082bb82a482c882cc",
          "current_body_hex": "50656f706c6520616c6c206f7665722074686520776f726c640a2061726520776f726b696e67206861726420746f206d616b65206d6f6e65792e0a2049742773207468652073616d6520696e207468657365207761746572732e",
          "Japanese": "あのね、今はね、世界中でいろんな\n人たちが儲けようとがんばってるわけよ\nこの海域でもそうなの",
          "current_English": "People all over the world\n are working hard to make money.\n It's the same in these waters."
        },
        {
          "file_path": "/data/SC0.DK4",
          "block": 49,
          "source_command_offset": 840,
          "current_command_offset": 802,
          "source_offset": 845,
          "current_offset": 807,
          "source_record_index": 86,
          "native_command_word": 16384,
          "selector": 9,
          "slots": [],
          "source_body_hex": "82e082a482bf82e582c182c68cbe82a295fb82f08d6c82a682c482c182c482ce8163",
          "current_body_hex": "436f756c6420796f75206265206d6f726520706f6c6974653f20",
          "Japanese": "もうちょっと言い方を考えてってば…",
          "current_English": "Could you be more polite? "
        },
        {
          "file_path": "/data/SC0.DK4",
          "block": 49,
