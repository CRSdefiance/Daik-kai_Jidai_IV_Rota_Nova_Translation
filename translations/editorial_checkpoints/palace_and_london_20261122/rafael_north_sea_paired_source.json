          "native_command_word": 16384,
          "selector": 2,
          "slots": [],
          "source_body_hex": "89bd82a997708e96814182c582b782c182c482a5814981480a82a082f182bd82bd82bf81498140924e82c9926682c182c40a82b182cc966b8a4382c58fa4948482b582e682a482c182c482e4815b82cc81498148",
          "current_body_hex": "4e65656420736f6d657468696e673f21200a2057686f207361696420796f7520636f756c64207472616465200a20696e20746865204e6f727468205365613f21",
          "Japanese": "何か用事、ですってぇ！？\nあんたたち！　誰に断って\nこの北海で商売しようってゆーの！？",
          "current_English": "Need something?! \n Who said you could trade \n in the North Sea?!"
        },
        {
