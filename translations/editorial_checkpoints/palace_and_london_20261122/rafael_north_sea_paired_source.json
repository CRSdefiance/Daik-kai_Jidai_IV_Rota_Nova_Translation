          "selector": 0,
          "slots": [],
          "source_body_hex": "816382a0814182cd82a282cd82a2",
          "current_body_hex": "55682e2e2e207965732e",
          "Japanese": "…あ、はいはい",
          "current_English": "Uh... yes."
        },
        {
          "file_path": "/data/SC0.DK4",
          "block": 49,
