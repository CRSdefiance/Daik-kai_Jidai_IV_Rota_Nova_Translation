          "source_offset": 437,
          "current_offset": 415,
          "source_record_index": 47,
          "native_command_word": 16384,
          "selector": 5,
          "slots": [],
          "source_body_hex": "82a082a08148814089bd8cbe82c182c482f182be8148814082a882a282b182e70a82b682e5815b82bf82e182f1814282a88c5a82b382f182bd82bf82f00a937b814582e7814582b9814582bd814582a2814582cc82a982c882c18149",
          "current_body_hex": "57686174277320746861742c206c6974746c65206c6164793f0a20596f75207265616c6c792077616e6e6120676574207573206d61643f20",
          "Japanese": "ああ？　何言ってんだ？　おいこら\nじょーちゃん。お兄さんたちを\n怒・ら・せ・た・い・のかなっ！",
          "current_English": "What's that, little lady?\n You really wanna get us mad? "
