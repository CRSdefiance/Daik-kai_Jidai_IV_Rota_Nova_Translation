      "source_selector": 74,
      "variant_slots": [],
      "source_Japanese": "ん？\nFI提督の話か？\n私が詳しく聞かせてやるぞ",
      "current_English": "Hm? Are you discussing Admiral \n FI? Allow me to give\n you the full account!"
    },
    {
      "id": "DK4_MES_B116_R0106",
      "source_command_offset": 1472,
      "current_command_offset": 1952,
      "source_offset": 1477,
      "current_offset": 1957,
      "source_command_hex": "0040ffff0016816382e082a495b782a282bd82a982e782a282a282e60000",
      "current_command_hex": "0040ffff00162e2e2e4927766520616c72656164792068656172642069742c207468616e6b732e200000",
      "source_selector": 22,
      "variant_slots": [],
      "source_Japanese": "…もう聞いたからいいよ",
      "current_English": "...I've already heard it, thanks. "
    },
