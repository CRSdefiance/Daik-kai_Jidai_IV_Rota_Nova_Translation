          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82d982a4814182bb82a482a9",
          "current_body_hex": "4f682c2049207365652e",
          "Japanese": "ほう、そうか",
          "current_English": "Oh, I see."
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1424,
          "current_command_offset": 1340,
          "source_offset": 1429,
          "current_offset": 1345,
