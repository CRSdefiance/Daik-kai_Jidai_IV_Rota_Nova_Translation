          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82bb82a482a9814182b682e182c882a282ed82e68149",
          "current_body_hex": "446f6e2774206a7573742073617920276f682c204920736565272120",
          "Japanese": "そうか、じゃないわよ！",
          "current_English": "Don't just say 'oh, I see'! "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1454,
          "current_command_offset": 1376,
          "source_offset": 1459,
          "current_offset": 1381,
          "source_record_index": 98,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82d382de82d382de0a82b182cc82c882dc82c182bf82eb82a282cc82aa82cc82a48163",
          "current_body_hex": "486d6d2e20546869732070616c652066656c6c6f772c2069732069742e2e2e",
          "Japanese": "ふむふむ\nこのなまっちろいのがのう…",
          "current_English": "Hmm. This pale fellow, is it..."
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1496,
          "current_command_offset": 1414,
          "source_offset": 1501,
          "current_offset": 1419,
          "source_record_index": 101,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "82ed81418e8482cd906582c98cbe82ed82ea82bd82a982e782c582cd0a82a082e882dc82b982f182aa81630a967b939682c9834e838a835883658342836982a88fec976c82cc82b182c682f08163",
          "current_body_hex": "492d69742069736e2774206a7573742062656361757365206f757220706172656e74730a207361696420736f2e2049207265616c6c790a20646f206361726520666f72204d697373204372697374696e612e2e2e",
          "Japanese": "わ、私は親に言われたからでは\nありませんが…\n本当にクリスティナお嬢様のことを…",
          "current_English": "I-it isn't just because our parents\n said so. I really\n do care for Miss Cristina..."
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1582,
          "current_command_offset": 1506,
          "source_offset": 1587,
          "current_offset": 1511,
          "source_record_index": 105,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "958382b382f182e095ea82b382f182e082c782a482e282e78e8482c90a817782a282c282dc82c582e08c9582c882f182a9905582e889f182b582c482c882a282c50a978e82bf928582af817882c182c48cbe82a282bd82a282e782b582a282cc0a82e682cb815b814282e282f182c882c182bf82e182a4",
          "current_body_hex": "49207468696e6b204d6f6d20616e64204461642077616e74206d652020202020200a20746f2071756974207377696e67696e6720612073776f7264200a20616e6420736574746c6520646f776e2e200a20497420647269766573206d65206372617a792e202020202020202020202020202020",
          "Japanese": "父さんも母さんもどうやら私に\n『いつまでも剣なんか振り回してないで\n落ち着け』って言いたいらしいの\nよねー。やんなっちゃう",
          "current_English": "I think Mom and Dad want me      \n to quit swinging a sword \n and settle down. \n It drives me crazy.               "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1708,
          "current_command_offset": 1628,
          "source_offset": 1713,
          "current_offset": 1633,
          "source_record_index": 108,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82de82a4814283778389838b836882cc8d6c82a682bb82a482c882b182c60a82b682e182a2814282e282cd82e88bb388e782f08ad488e182a682bd82a982cc82a48163",
          "current_body_hex": "486d70682e205468617420736f756e6473206c696b6520486172616c642e200a205065726861707320492077656e742077726f6e67206272696e67696e670a2068696d2075702e2e2e",
          "Japanese": "むう。ヘラルドの考えそうなこと\nじゃい。やはり教育を間違えたかのう…",
          "current_English": "Hmph. That sounds like Harald. \n Perhaps I went wrong bringing\n him up..."
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1782,
          "current_command_offset": 1708,
          "source_offset": 1787,
          "current_offset": 1713,
          "source_record_index": 111,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "82a082cc815b",
          "current_body_hex": "556d2e2e2e20",
          "Japanese": "あのー",
          "current_English": "Um... "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1796,
          "current_command_offset": 1722,
          "source_offset": 1801,
          "current_offset": 1727,
          "source_record_index": 115,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82a082f182bd82cd96d982c182c482c882b382a281490a82c5814182b382c182ab82cc986282c882f182be82af82c781630a914482aa89bd82c682a982c182c48148",
          "current_body_hex": "596f7520626520717569657421204e6f772c204772616e6470612c2077686174200a207765726520796f7520736179696e672061626f7574206120736869703f",
          "Japanese": "あんたは黙ってなさい！\nで、さっきの話なんだけど…\n船が何とかって？",
          "current_English": "You be quiet! Now, Grandpa, what \n were you saying about a ship?"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1870,
          "current_command_offset": 1794,
          "source_offset": 1875,
          "current_offset": 1799,
          "source_record_index": 119,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82a882a8814282bb82a482b682e182bb82a482b682e10a82a882dc82a682e082ed82b582c688ea8f8f82c9978882f182a982c60a8e7682c182c482cc82a4",
          "current_body_hex": "4f682c2072696768742120492074686f7567687420796f75206d69676874206c696b650a20746f20636f6d652077697468206d652e20",
          "Japanese": "おお。そうじゃそうじゃ\nおまえもわしと一緒に来んかと\n思ってのう",
          "current_English": "Oh, right! I thought you might like\n to come with me. "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1940,
          "current_command_offset": 1856,
          "source_offset": 1945,
          "current_offset": 1861,
          "source_record_index": 123,
          "native_command_word": 16384,
          "selector": 1,
          "slots": [],
          "source_body_hex": "82b682a282b382f182c982e682ea82ce0a82c882a982c882a982cc8c9582cc8e6782a28ee882be82c682a90a82d482b582c282af82be82aa81418e8482cc914482c98fe682c182c40a82e082e782a682dc82a282a98148",
          "current_body_hex": "4a756c696f207361797320796f752772650a20717569746520612073776f726473776f6d616e2e20506172646f6e0a206d6520666f722061736b696e67206f7574206f662074686520626c75652c200a206275742077696c6c20796f7520636f6d652061626f617264206d7920736869703f20",
          "Japanese": "じいさんによれば\nなかなかの剣の使い手だとか\nぶしつけだが、私の船に乗って\nもらえまいか？",
          "current_English": "Julio says you're\n quite a swordswoman. Pardon\n me for asking out of the blue, \n but will you come aboard my ship? "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2034,
          "current_command_offset": 1978,
          "source_offset": 2039,
          "current_offset": 1983,
          "source_record_index": 126,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "89bd81480a82b682c182bf82e182f1814182b182cc906c82bd82bf8141924e8148",
          "current_body_hex": "576861743f204772616e6470612c2077686f2061726520746865793f20",
          "Japanese": "何？\nじっちゃん、この人たち、誰？",
          "current_English": "What? Grandpa, who are they? "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2074,
          "current_command_offset": 2014,
          "source_offset": 2079,
          "current_offset": 2019,
          "source_record_index": 129,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82a482de814281698e9f82a982e78e9f82d682c691e595cf82b682e18142816a0a82a6815b82c182c6814182dc82b8814182b182bf82e782cd0a4649814546410a92f193c282b682e1",
          "current_body_hex": "57656c6c2e2e2e2028536f206d75636820746f206578706c61696e2e290a2046697273742c206d6565742041646d6972616c0a2046492046412e20",
          "Japanese": "うむ。（次から次へと大変じゃ。）\nえーっと、まず、こちらは\nFI・FA\n提督じゃ",
          "current_English": "Well... (So much to explain.)\n First, meet Admiral\n FI FA. "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2154,
          "current_command_offset": 2080,
          "source_offset": 2159,
          "current_offset": 2085,
          "source_record_index": 132,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "92f193c28148814082d682a6814182b882a282d482f18ee182a282cc82cb",
          "current_body_hex": "416e2061646d6972616c3f20596f7527726520617766756c6c7920796f756e672e20",
          "Japanese": "提督？　へえ、ずいぶん若いのね",
          "current_English": "An admiral? You're awfully young. "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2192,
          "current_command_offset": 2122,
          "source_offset": 2197,
          "current_offset": 2127,
          "source_record_index": 136,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82a882dc82a682e08f9782cc906782c582cd91bc97ac8e8e8d8782aa82c782a482c682a90a8cbe82a482c482a882c182bd82eb82a4814282c782a482b682e181480a90a28a45928682c98c958f708f438d7382c98d7382ad82c682a282a482cc82e00a88ab82ad82c882a982eb82a4",
          "current_body_hex": "596f7520736169642069742773206861726420666f7220776f6d656e200a20746f206368616c6c656e6765206f74686572207363686f6f6c732e0a20576879206e6f742074726176656c2074686520776f726c64200a20616e6420747261696e207769746820796f75722073776f72643f",
          "Japanese": "おまえも女の身では他流試合がどうとか\n言うておったろう。どうじゃ？\n世界中に剣術修行に行くというのも\n悪くなかろう",
          "current_English": "You said it's hard for women \n to challenge other schools.\n Why not travel the world \n and train with your sword?"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2310,
          "current_command_offset": 2242,
          "source_offset": 2315,
          "current_offset": 2247,
          "source_record_index": 139,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "82ed81418e8482cd94bd91ce82c582b782c1814981498149",
          "current_body_hex": "4e6f21204162736f6c7574656c79206e6f742120",
          "Japanese": "わ、私は反対ですっ！！！",
          "current_English": "No! Absolutely not! "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2342,
          "current_command_offset": 2270,
          "source_offset": 2347,
          "current_offset": 2275,
          "source_record_index": 143,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82bb82a482cb8163814282bb82ea82e082a282a282ed82cb0a8d7382ad82ed",
          "current_body_hex": "486d6d2e2e2e200a205468617420736f756e647320676f6f6420746f206d652e2049276c6c20676f2e",
          "Japanese": "そうね…。それもいいわね\n行くわ",
          "current_English": "Hmm... \n That sounds good to me. I'll go."
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2380,
          "current_command_offset": 2318,
          "source_offset": 2385,
          "current_offset": 2323,
          "source_record_index": 146,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "94bd91ce82c582b782c182c482ce81498149",
          "current_body_hex": "4920736169642049206f626a656374212120",
          "Japanese": "反対ですってば！！",
          "current_English": "I said I object!! "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2406,
          "current_command_offset": 2344,
          "source_offset": 2411,
          "current_offset": 2349,
          "source_record_index": 150,
          "native_command_word": 16384,
          "selector": 1,
          "slots": [],
          "source_body_hex": "816382b182cc926a82cd82c782a482b782e98148",
          "current_body_hex": "2e2e2e576861742061626f75742068696d3f",
          "Japanese": "…この男はどうする？",
          "current_English": "...What about him?"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2434,
          "current_command_offset": 2370,
          "source_offset": 2439,
          "current_offset": 2375,
          "source_record_index": 154,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82a2815b82cc82e6814282b381418177915082cd8b7d82b0817882c582b582e581480a82cb814182b682c182bf82e182f18149",
          "current_body_hex": "4e65766572206d696e642068696d2e204e6f2074696d65206c696b65200a207468652070726573656e742c2072696768742c204772616e6470613f",
          "Japanese": "いーのよ。さ、『善は急げ』でしょ？\nね、じっちゃん！",
          "current_English": "Never mind him. No time like \n the present, right, Grandpa?"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2492,
          "current_command_offset": 2436,
          "source_offset": 2497,
          "current_offset": 2441,
          "source_record_index": 157,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82b382b782aa89e482aa91b796ba0a95aa82a982c182c482a882e9814282a482de82a482de",
          "current_body_hex": "546861742773206d79206772616e6464617567687465722120596f7527766520676f740a2074686520726967687420696465612e20",
          "Japanese": "さすが我が孫娘\n分かっておる。うむうむ",
          "current_English": "That's my granddaughter! You've got\n the right idea. "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2540,
          "current_command_offset": 2500,
          "source_offset": 2545,
          "current_offset": 2505,
          "source_record_index": 160,
          "native_command_word": 16384,
          "selector": 1,
          "slots": [],
          "source_body_hex": "837e83948348815b838b82c682e282e7814182c282a282c482ad82e982a98148",
          "current_body_hex": "4d69766f722c207761732069743f20576f756c6420796f75206c696b650a20746f20636f6d6520746f6f3f20",
          "Japanese": "ミヴォールとやら、ついてくるか？",
          "current_English": "Mivor, was it? Would you like\n to come too? "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2580,
          "current_command_offset": 2552,
          "source_offset": 2585,
          "current_offset": 2557,
          "source_record_index": 164,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "82ed814182ed82bd82ad82b582cd8163",
          "current_body_hex": "572d77656c6c2e2e2e20",
          "Japanese": "わ、わたくしは…",
          "current_English": "W-well... "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2604,
          "current_command_offset": 2570,
          "source_offset": 2609,
          "current_offset": 2575,
          "source_record_index": 168,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82b182cc906c8141896a82b082c882a282cc814290858bb0957c8fc782c882cc82e60a82be82a982e792c782c182c482c882f182a982b182ea82c882a282ed82e682cb815b",
          "current_body_hex": "48652063616e2774207377696d2e200a204865277320746572726966696564206f662077617465722e200a20596f752063616e277420666f6c6c6f772075732c2063616e20796f753f",
          "Japanese": "この人、泳げないの。水恐怖症なのよ\nだから追ってなんかこれないわよねー",
          "current_English": "He can't swim. \n He's terrified of water. \n You can't follow us, can you?"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2680,
          "current_command_offset": 2650,
          "source_offset": 2685,
          "current_offset": 2655,
          "source_record_index": 171,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "82ad82c18163814282a982ad82c882e98fe382cd82c181490a82af81418c9582c58f9f958982be82c18149",
          "current_body_hex": "5468656e2074686572652773206f6e6c79206f6e65207468696e6720666f72206974210a20492d49206368616c6c656e676520796f7520746f2061206475656c21",
          "Japanese": "くっ…。かくなる上はっ！\nけ、剣で勝負だっ！",
          "current_English": "Then there's only one thing for it!\n I-I challenge you to a duel!"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2732,
          "current_command_offset": 2724,
          "source_offset": 2737,
          "current_offset": 2729,
          "source_record_index": 174,
          "native_command_word": 16384,
          "selector": 1,
          "slots": [],
          "source_body_hex": "81498149",
          "current_body_hex": "2121",
          "Japanese": "！！",
          "current_English": "!!"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2744,
          "current_command_offset": 2734,
          "source_offset": 2749,
          "current_offset": 2739,
          "source_record_index": 178,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "967b939682c982e082a4814195aa82a982f182c882a2906c82cb82c181490a82bd829f815b82c181498149",
          "current_body_hex": "596f75206a757374206e65766572206c6561726e2c20646f20796f753f2120487961612120",
          "Japanese": "本当にもう、分かんない人ねっ！\nたぁーっ！！",
          "current_English": "You just never learn, do you?! Hyaa! "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2806,
          "current_command_offset": 2790,
          "source_offset": 2811,
          "current_offset": 2795,
          "source_record_index": 182,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "82a482ed815b815b815b82c181498149814082a082bd82bd82bd82bd8149",
          "current_body_hex": "576161616821204f75636821",
          "Japanese": "うわーーーっ！！　あたたたた！",
          "current_English": "Waaah! Ouch!"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2844,
          "current_command_offset": 2810,
          "source_offset": 2849,
          "current_offset": 2815,
          "source_record_index": 186,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82bb82f182c882d682c182d282e88d9882b682e10a8e718b9f82c982be82c182c48f9f82c482e282b582c882a282ed82e6",
          "current_body_hex": "576974682061207374616e6365206c696b6520746861742c20796f75200a20636f756c646e277420626561742061206368696c642e",
          "Japanese": "そんなへっぴり腰じゃ\n子供にだって勝てやしないわよ",
          "current_English": "With a stance like that, you \n couldn't beat a child."
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 2900,
          "current_command_offset": 2870,
          "source_offset": 2905,
          "current_offset": 2875,
          "source_record_index": 189,
          "native_command_word": 16384,
