          "source_body_hex": "82c182c182c182c182c682a882a882a882a882c90a82b582c282c182b182a282ed82cb814981498149",
          "current_body_hex": "596f75206a75737420776f6e277420676976652075702c2077696c6c20796f753f2120",
          "Japanese": "っっっっとおおおおに\nしつっこいわね！！！",
          "current_English": "You just won't give up, will you?! "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 60,
          "current_command_offset": 54,
          "source_offset": 65,
          "current_offset": 59,
          "source_record_index": 8,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "82a882a88149814089e482aa88a482b582cc834e838a835883658342836981490a82c882ba82c982bb82f182c882c982dc82c597e282bd82ad82b782e982cc82c582b78148",
          "current_body_hex": "4f682c206d792062656c6f766564204372697374696e612120576879200a206d75737420796f7520626520736f20636f6c6420746f206d653f",
          "Japanese": "おお！　我が愛しのクリスティナ！\nなぜにそんなにまで冷たくするのです？",
          "current_English": "Oh, my beloved Cristina! Why \n must you be so cold to me?"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 136,
          "current_command_offset": 118,
          "source_offset": 141,
          "current_offset": 123,
          "source_record_index": 11,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82a082f182bd814182bf82e582c182c682a882a982b582a282f182b682e182c882a281480a82b182f182c882c98c9982ed82ea82c482c48141958192ca82c282a282c482ad82e98148",
          "current_body_hex": "5768617427732077726f6e67207769746820796f753f20576879200a206b65657020666f6c6c6f77696e6720736f6d656f6e65200a2077686f2063616e2774207374616e6420796f753f20",
          "Japanese": "あんた、ちょっとおかしいんじゃない？\nこんなに嫌われてて、普通ついてくる？",
          "current_English": "What's wrong with you? Why \n keep following someone \n who can't stand you? "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 216,
          "current_command_offset": 200,
          "source_offset": 221,
          "current_offset": 205,
          "source_record_index": 14,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "8fc682ea82c882ad82c482e082e682a282c582cd82c882a282c582b782a98160",
          "current_body_hex": "4e6f206e65656420746f2062652073687921",
          "Japanese": "照れなくてもよいではないですか～",
          "current_English": "No need to be shy!"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 256,
          "current_command_offset": 226,
          "source_offset": 261,
          "current_offset": 231,
          "source_record_index": 18,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82cd82a082c1814182e082a482a282e28142816382a082cc82cb82a50a8da596f182c182bd82c182c4906582aa8f9f8ee882c98c8882df82bd82be82af0a82c882cc814981408e8482cd8c8b8da582c882f182c482b782e98b430a91539152814182c882a282cc8149",
          "current_body_hex": "5567682c2049277665206861642069742e204f757220706172656e74730a20617272616e6765642074686520656e676167656d656e740a20776974686f75742061736b696e67206d652e200a2049276d206e6f742067657474696e67206d6172726965642e20506572696f6421",
          "Japanese": "はあっ、もういや。…あのねぇ\n婚約ったって親が勝手に決めただけ\nなの！　私は結婚なんてする気\n全然、ないの！",
          "current_English": "Ugh, I've had it. Our parents\n arranged the engagement\n without asking me. \n I'm not getting married. Period!"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 368,
          "current_command_offset": 342,
          "source_offset": 373,
          "current_offset": 347,
          "source_record_index": 21,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "82a082c882bd82cc82bb82cc90ba82f095b782a282c482a282e782ea82e982be82af82c50a8e8482cd8d4b82b982c8829f82cc82c582a582b78149",
          "current_body_hex": "54686520736f756e64206f6620796f757220766f69636520697320616c6c200a2049206e65656420746f2062652068617070792120",
          "Japanese": "あなたのその声を聞いていられるだけで\n私は幸せなぁのでぇす！",
          "current_English": "The sound of your voice is all \n I need to be happy! "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 436,
          "current_command_offset": 404,
          "source_offset": 441,
          "current_offset": 409,
          "source_record_index": 24,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82ce82a982c18149",
          "current_body_hex": "4d6f726f6e21",
          "Japanese": "ばかっ！",
          "current_English": "Moron!"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 454,
          "current_command_offset": 420,
          "source_offset": 459,
          "current_offset": 425,
          "source_record_index": 28,
          "native_command_word": 16384,
          "selector": 1,
          "slots": [],
          "source_body_hex": "816382a082cc906c816382c582b782a98148",
          "current_body_hex": "2e2e2e49732074686174206865723f20",
          "Japanese": "…あの人…ですか？",
          "current_English": "...Is that her? "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 480,
          "current_command_offset": 444,
          "source_offset": 485,
          "current_offset": 449,
          "source_record_index": 32,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82bb815b82b682e182e6",
          "current_body_hex": "5468617427732072696768742e20",
          "Japanese": "そーじゃよ",
          "current_English": "That's right. "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 498,
          "current_command_offset": 466,
          "source_offset": 503,
          "current_offset": 471,
          "source_record_index": 36,
          "native_command_word": 16384,
          "selector": 1,
          "slots": [],
          "source_body_hex": "82bf82e582c182c6906795d382aa8353835e8353835e82b582c482a282e90a82e682a482c582b782aa8163",
          "current_body_hex": "536865206c6f6f6b732061206c6974746c6520627573790a20617420746865206d6f6d656e742e2e2e",
          "Japanese": "ちょっと身辺がゴタゴタしている\nようですが…",
          "current_English": "She looks a little busy\n at the moment..."
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 548,
          "current_command_offset": 514,
          "source_offset": 553,
          "current_offset": 519,
          "source_record_index": 39,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82a2815b82e281429153915282a982dc82ed82f182e60a82a8815b82a281498140834e838a83588365834283698149",
          "current_body_hex": "4f682c207468617420776f6e2774206d61747465722e200a204865792c204372697374696e6121",
          "Japanese": "いーや。全然かまわんよ\nおーい！　クリスティナ！",
          "current_English": "Oh, that won't matter. \n Hey, Cristina!"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 616,
          "current_command_offset": 574,
          "source_offset": 621,
          "current_offset": 579,
          "source_record_index": 43,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82a882a88141834e838a835883658342836981490a8cb38b4382b682e182c182bd82a98148",
          "current_body_hex": "4372697374696e612120486f77206861766520796f75206265656e3f20",
          "Japanese": "おお、クリスティナ！\n元気じゃったか？",
          "current_English": "Cristina! How have you been? "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 672,
          "current_command_offset": 622,
          "source_offset": 677,
          "current_offset": 627,
          "source_record_index": 47,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82b682c182bf82e182f18149814082a282c2838d83938368839382d68148",
          "current_body_hex": "4772616e64706121205768656e2064696420796f752067657420746f204c6f6e646f6e3f",
          "Japanese": "じっちゃん！　いつロンドンへ？",
          "current_English": "Grandpa! When did you get to London?"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 710,
          "current_command_offset": 666,
          "source_offset": 715,
          "current_offset": 671,
          "source_record_index": 51,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "8da182b582aa82bd82b682e10a82dc82bd8141914482c98fe682e982b182c682c982c882c182c482cc82a7",
          "current_body_hex": "4a757374206e6f772e2049276d20676f696e6720746f2073656120616761696e2e",
          "Japanese": "今しがたじゃ\nまた、船に乗ることになってのぉ",
          "current_English": "Just now. I'm going to sea again."
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 760,
          "current_command_offset": 706,
          "source_offset": 765,
          "current_offset": 711,
          "source_record_index": 54,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82a682a682c1814182dc82bd829f814981480a958382b382f182c982e095ea82b382f182c982e08e7e82df82e782ea82e982e68148",
          "current_body_hex": "576861742c20616761696e3f21204d6f6d20616e64204461642077696c6c20747279200a20746f2073746f7020796f7521",
          "Japanese": "ええっ、またぁ！？\n父さんにも母さんにも止められるよ？",
          "current_English": "What, again?! Mom and Dad will try \n to stop you!"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 820,
          "current_command_offset": 762,
          "source_offset": 825,
          "current_offset": 767,
          "source_record_index": 57,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82a882dc82a682aa8cbe82ed82c882af82ea82ce0a82ce82ea82c882a282cc82b682e1814282d382a782c182d382a782c1",
          "current_body_hex": "5468657920776f6e27742066696e64206f75740a20696620796f7520646f6e27742074656c6c207468656d2e20486f20686f21",
          "Japanese": "おまえが言わなければ\nばれないのじゃ。ふぉっふぉっ",
          "current_English": "They won't find out\n if you don't tell them. Ho ho!"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 876,
          "current_command_offset": 820,
          "source_offset": 881,
          "current_offset": 825,
          "source_record_index": 60,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82a0815b82cc815b82cb8160",
          "current_body_hex": "4f682c20636f6d65206f6e2e2e2e",
          "Japanese": "あーのーね～",
          "current_English": "Oh, come on..."
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 896,
          "current_command_offset": 842,
          "source_offset": 901,
          "current_offset": 847,
          "source_record_index": 64,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "82bb82ea82e682e882c782a482b682e10a82a882dc82a682e091448f6f82b782e98b4382cd82c882a282a982cc8148",
          "current_body_hex": "416e797761792c20686f772061626f75740a20676f696e6720746f207365612077697468206d653f20",
          "Japanese": "それよりどうじゃ\nおまえも船出する気はないかの？",
          "current_English": "Anyway, how about\n going to sea with me? "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 950,
          "current_command_offset": 890,
          "source_offset": 955,
          "current_offset": 895,
          "source_record_index": 67,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "81498149814082c8815b82f182c582b782c6814981480a82bb82ea82cd82a282af82dc82b982f18149",
          "current_body_hex": "576861743f21204162736f6c7574656c79206e6f742120",
          "Japanese": "！！　なーんですと！？\nそれはいけません！",
          "current_English": "What?! Absolutely not! "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 998,
          "current_command_offset": 920,
          "source_offset": 1003,
          "current_offset": 925,
          "source_record_index": 70,
          "native_command_word": 16384,
          "selector": 6,
          "slots": [],
          "source_body_hex": "89bd82b682e182a20a82b182a282c282cd8148",
          "current_body_hex": "57686f20697320746869733f20",
          "Japanese": "何じゃい\nこいつは？",
          "current_English": "Who is this? "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1024,
          "current_command_offset": 940,
          "source_offset": 1029,
          "current_offset": 945,
          "source_record_index": 73,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "958382b382f182cc9746924282cc91a78e710a82a6815b82c182c689bd82c482c182bd82c182af",
          "current_body_hex": "54686520736f6e206f66206f6e65206f6620446164277320667269656e64732e200a20576861742077617320686973206e616d6520616761696e3f",
          "Japanese": "父さんの友達の息子\nえーっと何てったっけ",
          "current_English": "The son of one of Dad's friends. \n What was his name again?"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1070,
          "current_command_offset": 1006,
          "source_offset": 1075,
          "current_offset": 1011,
          "source_record_index": 76,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "82a882a88141834e838a835883658342836981490a82bb82f182c882c98fc682ea82c882ad82c682e081490a82a882b682a282b382dc82c582a282e782c182b582e182a282dc82b782a98148",
          "current_body_hex": "4f682c204372697374696e61212054686572652773206e6f206e6565640a20746f20626520736879212041726520796f7520686572206772616e646661746865723f",
          "Japanese": "おお、クリスティナ！\nそんなに照れなくとも！\nおじいさまでいらっしゃいますか？",
          "current_English": "Oh, Cristina! There's no need\n to be shy! Are you her grandfather?"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1154,
          "current_command_offset": 1080,
          "source_offset": 1159,
          "current_offset": 1085,
          "source_record_index": 80,
          "native_command_word": 16384,
          "selector": 79,
          "slots": [],
          "source_body_hex": "82a88f8982c982a896da82c982a982a982e882dc82b70a8e8482cd837e82c183948348815b838b81490a837e83948348815b838b814583518393836382c6905c82b582dc82b70a88c88ce382a88ca9926d82e882a882ab82f082c1",
          "current_body_hex": "4120706c65617375726520746f206d65657420796f7521204d69766f7221200a204d69766f722047656e7a2c20617420796f7572207365727669636521",
          "Japanese": "お初にお目にかかります\n私はミっヴォール！\nミヴォール・ゲンツと申します\n以後お見知りおきをっ",
          "current_English": "A pleasure to meet you! Mivor! \n Mivor Genz, at your service!"
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1252,
          "current_command_offset": 1148,
          "source_offset": 1257,
          "current_offset": 1153,
          "source_record_index": 83,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "82bb82a482bb82a4814182c882f182a9814182bb82ea82bb82ea0a8b4382aa82c282a282bd82e70a958382b382f182bd82bf82aa8f9f8ee882c996f191a982b582bf82e182c182c482c4",
          "current_body_hex": "52696768742c2074686174277320746865206e616d652e204265666f7265200a2049206b6e65772069742c2044616420616e6420746865206f74686572730a20686164206d616465207468652077686f6c6520617272616e67656d656e74200a20776974686f7574206d652e",
          "Japanese": "そうそう、なんか、それそれ\n気がついたら\n父さんたちが勝手に約束しちゃってて",
          "current_English": "Right, that's the name. Before \n I knew it, Dad and the others\n had made the whole arrangement \n without me."
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1334,
          "current_command_offset": 1264,
          "source_offset": 1339,
          "current_offset": 1269,
          "source_record_index": 87,
          "native_command_word": 16384,
          "selector": 7,
          "slots": [],
          "source_body_hex": "8ec082cd8e84814182b182cc814182ed82af82cc95aa82a982f182c882a282cc82c60a8da596f182b582bd82c182c482b182c682c982c882c182c482f182cc",
          "current_body_hex": "4170706172656e746c792049276d20656e676167656420746f20746869732e2e2e0a2077686174657665722068652069732e20",
          "Japanese": "実は私、この、わけの分かんないのと\n婚約したってことになってんの",
          "current_English": "Apparently I'm engaged to this...\n whatever he is. "
        },
        {
          "file_path": "/data/SC1.DK4",
          "block": 85,
          "source_command_offset": 1404,
          "current_command_offset": 1322,
          "source_offset": 1409,
