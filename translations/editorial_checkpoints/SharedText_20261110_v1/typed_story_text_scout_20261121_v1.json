        ],
        "body_hex": "537061696e2c207768696368207365697a656420506f72747567616c2e",
        "text": "Spain, which seized Portugal."
      },
      "source_object_hex": "002100002000837c838b8367834b838b82f0924482c182bd835883798343839382c582b70000816382e682ad95aa82a982e882dc82b982f10000",
      "current_object_hex": "002100001e00537061696e2c207768696368207365697a656420506f72747567616c2e002e2e2e576520646f6e2774206b6e6f772e00",
      "glyph_lead": false,
      "caption_lead": true,
      "context": {
        "source": [
          {
            "file_path": "/data/SC0.DK4",
            "block": 60,
            "command_offset": 768,
            "text_offset": 774,
            "word": "0x2100",
            "selector": null,
            "slots": [
              0
            ],
            "body_hex": "837c838b8367834b838b82f0924482c182bd835883798343839382c582b7",
            "text": "ポルトガルを奪ったスペインです"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 60,
            "command_offset": 768,
            "text_offset": 806,
            "word": "0x2100",
            "selector": null,
            "slots": [
              1
            ],
            "body_hex": "816382e682ad95aa82a982e882dc82b982f1",
            "text": "…よく分かりません"
          }
        ],
        "current": [
          {
            "file_path": "/data/SC0.DK4",
            "block": 60,
            "command_offset": 736,
            "text_offset": 742,
            "word": "0x2100",
            "selector": null,
            "slots": [
              0
            ],
            "body_hex": "537061696e2c207768696368207365697a656420506f72747567616c2e",
            "text": "Spain, which seized Portugal."
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 60,
            "command_offset": 736,
            "text_offset": 772,
            "word": "0x2100",
            "selector": null,
            "slots": [
              1
            ],
            "body_hex": "2e2e2e576520646f6e2774206b6e6f772e",
            "text": "...We don't know."
          }
        ]
      }
    },
    {
      "source": {
        "file_path": "/data/SC0.DK4",
        "block": 84,
        "command_offset": 5298,
        "text_offset": 5306,
        "word": "0x2200",
        "selector": null,
        "slots": [
          0
        ],
        "body_hex": "8cb582b582a28c5097fb82f08ef382af82e9",
        "text": "厳しい訓練を受ける"
      },
      "current": {
        "file_path": "/data/SC0.DK4",
        "block": 84,
        "command_offset": 5256,
        "text_offset": 5264,
        "word": "0x2200",
        "selector": null,
        "slots": [
          0
        ],
        "body_hex": "49276c6c2074616b652074686520746f75676820747261696e696e672e",
        "text": "I'll take the tough training."
      },
      "source_object_hex": "00220000140022008cb582b582a28c5097fb82f08ef382af82e90000986282be82af82f095b782ad00008ea995aa82cc82e282e895fb82f08ad182ad0000",
      "current_object_hex": "002200001e003a0049276c6c2074616b652074686520746f75676820747261696e696e672e004a757374206c697374656e20746f20746865206c6573736f6e2e00004b656570206d79206f776e207374796c652e0000",
      "glyph_lead": false,
      "caption_lead": true,
      "context": {
        "source": [
          {
            "file_path": "/data/SC0.DK4",
            "block": 84,
            "command_offset": 5192,
            "text_offset": 5197,
            "word": "0x4000",
            "selector": 16,
            "slots": [],
            "body_hex": "82bb82ea82c582cd816381428e8482aa8a4382c98f6f82e9914f82c90a8bb382a682c482a882ad82b182c682aa82a082e9814282c782a482be81480a93c195ca8c5097fb82f08ef382af82e98b4382aa82a082e982a982c88148",
            "text": "それでは…。私が海に出る前に\n教えておくことがある。どうだ？\n特別訓練を受ける気があるかな？"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 84,
            "command_offset": 5298,
            "text_offset": 5306,
            "word": "0x2200",
            "selector": null,
            "slots": [
              0
            ],
            "body_hex": "8cb582b582a28c5097fb82f08ef382af82e9",
            "text": "厳しい訓練を受ける"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 84,
            "command_offset": 5298,
            "text_offset": 5326,
            "word": "0x2200",
            "selector": null,
            "slots": [
              1
            ],
            "body_hex": "986282be82af82f095b782ad",
            "text": "話だけを聞く"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 84,
            "command_offset": 5298,
            "text_offset": 5340,
            "word": "0x2200",
            "selector": null,
            "slots": [
              2
            ],
            "body_hex": "8ea995aa82cc82e282e895fb82f08ad182ad",
            "text": "自分のやり方を貫く"
          }
        ],
        "current": [
          {
            "file_path": "/data/SC0.DK4",
            "block": 84,
            "command_offset": 5130,
            "text_offset": 5135,
            "word": "0x4000",
            "selector": 16,
            "slots": [],
            "body_hex": "4265666f7265204920676f20746f207365612c20746865726527730a20736f6d657468696e6720492764206c696b6520746f20746561636820796f752e200a20486f772061626f757420736f6d65207370656369616c20747261696e696e673f2020202020202020202020202020",
            "text": "Before I go to sea, there's\n something I'd like to teach you. \n How about some special training?              "
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 84,
            "command_offset": 5256,
            "text_offset": 5264,
            "word": "0x2200",
            "selector": null,
            "slots": [
              0
            ],
            "body_hex": "49276c6c2074616b652074686520746f75676820747261696e696e672e",
            "text": "I'll take the tough training."
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 84,
            "command_offset": 5256,
            "text_offset": 5294,
            "word": "0x2200",
            "selector": null,
            "slots": [
              1
            ],
            "body_hex": "4a757374206c697374656e20746f20746865206c6573736f6e2e",
            "text": "Just listen to the lesson."
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 84,
            "command_offset": 5256,
            "text_offset": 5322,
            "word": "0x2200",
            "selector": null,
            "slots": [
              2
            ],
            "body_hex": "4b656570206d79206f776e207374796c652e",
            "text": "Keep my own style."
          }
        ]
      }
    },
    {
      "source": {
        "file_path": "/data/SC0.DK4",
        "block": 127,
        "command_offset": 488,
        "text_offset": 508,
        "word": "0x2100",
        "selector": null,
        "slots": [
          1
        ],
        "body_hex": "959782cc95fb8a7082aa82e682ad82c882a282a982e08163",
        "text": "風の方角がよくないかも…"
      },
      "current": {
        "file_path": "/data/SC0.DK4",
        "block": 127,
        "command_offset": 466,
        "text_offset": 486,
        "word": "0x2100",
        "selector": null,
        "slots": [
          1
        ],
        "body_hex": "5468652077696e64206d6967687420626520616761696e73742075732e2e2e",
        "text": "The wind might be against us..."
      },
      "source_object_hex": "002100000e00836f83628360838a82c582b70000959782cc95fb8a7082aa82e682ad82c882a282a982e081630000",
      "current_object_hex": "002100000e004927766520676f742069742100005468652077696e64206d6967687420626520616761696e73742075732e2e2e00",
      "glyph_lead": false,
      "caption_lead": true,
      "context": {
        "source": [
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 276,
            "text_offset": 281,
            "word": "0x4000",
            "selector": 254,
            "slots": [],
            "body_hex": "906982de95fb8cfc82c98d8782ed82b982c48f5c8e9a837b835e839382f0899f82b782a90a89e696ca82f0835e8362836082b582c482ad82be82b382a2",
            "text": "進む方向に合わせて十字ボタンを押すか\n画面をタッチしてください"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 344,
            "text_offset": 349,
            "word": "0x4000",
            "selector": 254,
            "slots": [],
            "body_hex": "835e836283608379839382cc8fea8d8782cd8ea993ae934982c994bf82aa0a8dc5934b82c895fb8cfc82c982c882e882dc82b70a92e28e7e82b582bd82a28fea8d8782cd8af88acd82f00a835e8362836082b582c482ad82be82b382a2",
            "text": "タッチペンの場合は自動的に帆が\n最適な方向になります\n停止したい場合は旗艦を\nタッチしてください"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 444,
            "text_offset": 449,
            "word": "0x4000",
            "selector": 6,
            "slots": [],
            "body_hex": "8da182cc90e096be82c595aa82a982c182bd82a982cc82a481480a82c782a482b682e18148",
            "text": "今の説明で分かったかのう？\nどうじゃ？"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 488,
            "text_offset": 494,
            "word": "0x2100",
            "selector": null,
            "slots": [
              0
            ],
            "body_hex": "836f83628360838a82c582b7",
            "text": "バッチリです"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 488,
            "text_offset": 508,
            "word": "0x2100",
            "selector": null,
            "slots": [
              1
            ],
            "body_hex": "959782cc95fb8a7082aa82e682ad82c882a282a982e08163",
            "text": "風の方角がよくないかも…"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 542,
            "text_offset": 547,
            "word": "0x4000",
            "selector": 6,
            "slots": [],
            "body_hex": "82bb82cc92b28e7182c5978a82de82bc82a2814192f193c28149",
            "text": "その調子で頼むぞい、提督！"
          }
        ],
        "current": [
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 270,
            "text_offset": 275,
            "word": "0x4000",
            "selector": 254,
            "slots": [],
            "body_hex": "50726573732074686520442d50616420746f2061696d2074686520736869702c200a206f722074617020776865726520796f752077616e7420746f207361696c2e",
            "text": "Press the D-Pad to aim the ship, \n or tap where you want to sail."
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 342,
            "text_offset": 347,
            "word": "0x4000",
            "selector": 254,
            "slots": [],
            "body_hex": "546865207374796c7573206175746f6d61746963616c6c7920736574730a20746865207361696c7320617420746865206265737420616e676c652e200a20546f7563682074686520666c61677368697020746f2073746f702e",
            "text": "The stylus automatically sets\n the sails at the best angle. \n Touch the flagship to stop."
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 438,
            "text_offset": 443,
            "word": "0x4000",
            "selector": 6,
            "slots": [],
            "body_hex": "4469642074686174206d616b652073656e73653f20",
            "text": "Did that make sense? "
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 466,
            "text_offset": 472,
            "word": "0x2100",
            "selector": null,
            "slots": [
              0
            ],
            "body_hex": "4927766520676f7420697421",
            "text": "I've got it!"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 466,
            "text_offset": 486,
            "word": "0x2100",
            "selector": null,
            "slots": [
              1
            ],
            "body_hex": "5468652077696e64206d6967687420626520616761696e73742075732e2e2e",
            "text": "The wind might be against us..."
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 127,
            "command_offset": 526,
            "text_offset": 531,
            "word": "0x4000",
            "selector": 6,
            "slots": [],
            "body_hex": "4b6565702069742075702c2041646d6972616c21",
            "text": "Keep it up, Admiral!"
          }
        ]
      }
    },
    {
      "source": {
        "file_path": "/data/SC0.DK4",
        "block": 146,
        "command_offset": 404,
        "text_offset": 440,
        "word": "0x2100",
        "selector": null,
        "slots": [
          1
        ],
        "body_hex": "82c782b182a9957c82bb82a482c8906c82be814282e282df82c482a882b182a4",
        "text": "どこか怖そうな人だ。やめておこう"
      },
      "current": {
        "file_path": "/data/SC0.DK4",
        "block": 146,
        "command_offset": 468,
        "text_offset": 498,
        "word": "0x2100",
        "selector": null,
        "slots": [
          1
        ],
        "body_hex": "486527732072617468657220696e74696d69646174696e672e20426574746572206e6f742e",
        "text": "He's rather intimidating. Better not."
      },
      "source_object_hex": "002100001e00926682e982ed82af82c982cd82a282a982c882a282be82eb82a482c8000082c782b182a9957c82bb82a482c8906c82be814282e282df82c482a882b182a40000",
      "current_object_hex": "002100001800492063616e20686172646c79207265667573652e2e2e0000486527732072617468657220696e74696d69646174696e672e20426574746572206e6f742e00",
      "glyph_lead": false,
      "caption_lead": true,
      "context": {
        "source": [
          {
            "file_path": "/data/SC0.DK4",
            "block": 146,
            "command_offset": 282,
            "text_offset": 287,
            "word": "0x4000",
            "selector": 0,
            "slots": [],
            "body_hex": "82a282a6814182bb82f182c88163",
            "text": "いえ、そんな…"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 146,
            "command_offset": 304,
            "text_offset": 309,
            "word": "0x4000",
            "selector": 37,
            "slots": [],
            "body_hex": "82bf82e582c182c6918a926b82aa82a082e982f182be82aa0a82a282a282a982c88148",
            "text": "ちょっと相談があるんだが\nいいかな？"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 146,
            "command_offset": 346,
            "text_offset": 351,
            "word": "0x4000",
            "selector": 0,
            "slots": [],
            "body_hex": "816995a890c382a982be82af82c788d08cb582cc82a082e9906c82be82c881630a814082e682b5814182b182b182cd8163816a",
            "text": "（物静かだけど威厳のある人だな…\n　よし、ここは…）"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 146,
            "command_offset": 404,
            "text_offset": 410,
            "word": "0x2100",
            "selector": null,
            "slots": [
              0
            ],
            "body_hex": "926682e982ed82af82c982cd82a282a982c882a282be82eb82a482c8",
            "text": "断るわけにはいかないだろうな"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 146,
            "command_offset": 404,
            "text_offset": 440,
            "word": "0x2100",
            "selector": null,
            "slots": [
              1
            ],
            "body_hex": "82c782b182a9957c82bb82a482c8906c82be814282e282df82c482a882b182a4",
            "text": "どこか怖そうな人だ。やめておこう"
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 146,
            "command_offset": 482,
            "text_offset": 487,
            "word": "0x4000",
            "selector": 37,
            "slots": [],
            "body_hex": "8fad82b590e682dc82c50a82b291ab984a8ae882a482b182c682c982c882e982f182be82aa",
            "text": "少し先まで\nご足労願うことになるんだが"
          }
        ],
        "current": [
          {
            "file_path": "/data/SC0.DK4",
            "block": 146,
            "command_offset": 334,
            "text_offset": 339,
            "word": "0x4000",
            "selector": 0,
            "slots": [],
            "body_hex": "4e6f74207265616c6c792e2e2e20",
            "text": "Not really... "
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 146,
            "command_offset": 356,
            "text_offset": 361,
            "word": "0x4000",
            "selector": 37,
            "slots": [],
            "body_hex": "546865726520697320736f6d657468696e6720492764206c696b650a20746f2064697363757373207769746820796f752e204d617920493f20",
            "text": "There is something I'd like\n to discuss with you. May I? "
          },
          {
            "file_path": "/data/SC0.DK4",
            "block": 146,
            "command_offset": 420,
            "text_offset": 425,
            "word": "0x4000",
            "selector": 0,
            "slots": [],
            "body_hex": "2851756965742c20796574206469676e69666965642e2e2e200a20416c6c2072696768742e2e2e2920",
