        "pointer": 37378688,
        "compiled_hex": "412063617270656e7465722063616e207265706169720a64616d616765642073686970732e00",
        "profile": "refit-help-168x84-pending-flush-v1"
      },
      {
        "message_id": 1249,
        "English": "A ship's doctor can treat illnesses affecting officers and sailors.",
        "lines": [
          "A ship's doctor can treat",
          "illnesses affecting",
          "officers and sailors."
        ],
        "pointer": 37378726,
        "compiled_hex": "412073686970277320646f63746f722063616e207472656174200a696c6c6e657373657320616666656374696e67200a6f6666696365727320616e64207361696c6f72732e00",
        "profile": "refit-help-168x84-pending-flush-v1"
      },
      {
        "message_id": 1250,
        "English": "A chief cook saves water and food and helps sailors tire less quickly.",
        "lines": [
          "A chief cook saves water",
          "and food and helps sailors",
          "tire less quickly."
        ],
        "pointer": 37378796,
        "compiled_hex": "4120636869656620636f6f6b2073617665732077617465720a616e6420666f6f6420616e642068656c7073207361696c6f72730a74697265206c65737320717569636b6c792e00",
        "profile": "refit-help-168x84-pending-flush-v1"
      },
      {
        "message_id": 1251,
        "English": "Officers in this room recover their morale and help sailors tire less quickly.",
        "lines": [
          "Officers in this room",
          "recover their morale and",
          "help sailors tire less",
          "quickly."
        ],
        "pointer": 37378867,
