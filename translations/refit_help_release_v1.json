        "profile": "refit-help-168x84-pending-flush-v1"
      },
      {
        "message_id": 1281,
        "English": "You can fit extra armor here.",
        "lines": [
          "You can fit extra armor",
          "here."
        ],
        "pointer": 37380110,
        "compiled_hex": "596f752063616e206669742065787472612061726d6f72200a686572652e00",
        "profile": "refit-help-168x84-pending-flush-v1"
      },
      {
        "message_id": 1282,
        "English": "You can add a stern gun here. Large ships can also add a jigger spanker.",
        "lines": [
