        "profile": "refit-help-168x84-pending-flush-v1"
      },
      {
        "message_id": 1274,
        "English": "A ram lets you attack by ramming the side of an enemy ship.",
        "lines": [
          "A ram lets you attack by",
          "ramming the side of an",
          "enemy ship."
        ],
        "pointer": 37379641,
        "compiled_hex": "412072616d206c65747320796f752061747461636b2062790a72616d6d696e67207468652073696465206f6620616e0a656e656d7920736869702e00",
        "profile": "refit-help-168x84-pending-flush-v1"
      },
      {
        "message_id": 1275,
        "English": "A marine captain increases boarding attack power. You can install up to four quarters.",
        "lines": [
          "A marine captain increases",
          "boarding attack power. You",
          "can install up to four",
          "quarters."
        ],
        "pointer": 37379701,
        "compiled_hex": "41206d6172696e65206361707461696e20696e637265617365730a626f617264696e672061747461636b20706f7765722e20596f750a63616e20696e7374616c6c20757020746f20666f75720a71756172746572732e00",
        "profile": "refit-help-168x84-pending-flush-v1"
      },
      {
        "message_id": 1276,
        "English": "A gunner increases firing speed. You can install up to four quarters.",
        "lines": [
          "A gunner increases firing",
          "speed. You can install up",
          "to four quarters."
        ],
        "pointer": 37379788,
        "compiled_hex": "412067756e6e657220696e6372656173657320666972696e67200a73706565642e20596f752063616e20696e7374616c6c207570200a746f20666f75722071756172746572732e00",
        "profile": "refit-help-168x84-pending-flush-v1"
      },
      {
        "message_id": 1277,
        "English": "This room stores water and food.",
        "lines": [
