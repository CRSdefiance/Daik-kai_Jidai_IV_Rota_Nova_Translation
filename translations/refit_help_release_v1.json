        "compiled_hex": "41206a6967676572207370616e6b657220696d70726f766573200a666f72652d616e642d61667420706572666f726d616e63652c200a696e6372656173696e6720737065656420616761696e73740a7468652077696e642e00",
        "profile": "refit-help-168x84-pending-flush-v1"
      },
      {
        "message_id": 1270,
        "English": "Extra armor increases durability but slightly reduces speed.",
        "lines": [
