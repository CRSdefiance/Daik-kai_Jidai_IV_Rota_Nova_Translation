      "page_count": 1,
      "visible_lines": [
        "Bribe",
        "Choose a town in the current sea region",
        "where another faction operates. Bribe a",
        "broker there to take some of that",
        "faction's market share. Your Strategist",
        "must be skilled enough to think of this",
        "scheme."
      ],
