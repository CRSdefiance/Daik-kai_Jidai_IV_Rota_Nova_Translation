      "visible_lines": [
        "Search Mode (At Sea)",
        "In Info, press Y or R to switch to",
        "Search. Press A to search the area",
        "inside the frame. You may find water,",
        "food or items. If you find nothing, your",
        "sailors gain 3 fatigue. Sailors may",
        "desert or be attacked by wild animals",
        "during a search."
      ],
      "links": [
