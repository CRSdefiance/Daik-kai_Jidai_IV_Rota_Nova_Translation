      "visible_lines": [
        "Auto Move",
        "Choose a destination town and your fleet",
        "will sail there automatically. You need a",
        "Captain and a Surveyor. Your starting",
        "town and destination must be connected on",
        "the Route Map, and your faction must have",
        "market share in both towns and every town",
        "along the route. The map marks usable",
        "routes in red."
      ],
