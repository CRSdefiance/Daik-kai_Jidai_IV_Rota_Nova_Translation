    {
      "id": "DK4_SAILING_SEARCH_MODE_PANEL_V1",
      "source_address": "02147540",
      "pointer_site": "0206F418",
      "source_allocation_bytes_including_NUL": 305,
      "source_japanese": "探索モード。Ａボタンで探索を実行します。探索の結果、水・食糧・アイテムなどが見つかることがあります。見つからなかったときは、水夫の疲労度が３上がります。探索途中で水夫が脱走したり、獣に襲われたりすることもあります。",
      "heading": "Search Mode",
      "english": "Press A to search. You may find water, food, items, or other supplies. Find nothing? Crew fatigue goes up by 3. Sailors may desert or be attacked by wild animals during a search.",
      "context": "A second Y press from normal sailing selects Search Mode; the lower screen highlights the player's ship and offers A Search.",
      "source_meaning": "A executes a search. Water, food or items may be found. Failure adds exactly 3 sailor fatigue; desertion or animal attacks can occur during searching.",
      "localization_note": "Keep the exact three-point cost tied to an unsuccessful search. A separate sentence gives the risks of searching in general.",
      "native_capture_frame": 17900,
      "review": {
        "source": true,
        "context": true,
        "localization": true,
        "naturalness": true,
        "formatting": true
      },
      "source_hex": "",
      "previous_English": "Press A to search. You may find water, food, items, or other supplies. If you find nothing, sailor fatigue rises by 3. Sailors may desert or be attacked by wild animals while searching.",
