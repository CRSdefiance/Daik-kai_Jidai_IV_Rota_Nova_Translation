  "source_owned_VM_adapter": "def choice_vm(arm, object_bytes, alignment):\n    cpu = machine(arm)\n    text, owner, provider, result, cursor, rect = (0x02430020, 0x02431020, 0x02432020,\n                                                 0x02433020, 0x02433120, 0x02434020)\n    assert alignment in [0,2];text+=alignment\n    cpu.mem_write(text - 16, b'\\xA5' * (len(object_bytes)+32))\n    cpu.mem_write(text, object_bytes)\n    original = bytes(cpu.mem_read(text - 16, len(object_bytes)+32))\n    cpu.mem_write(owner, struct.pack('<2I', 0, text))\n    call(cpu, 0x2A3D8, (provider, owner))\n    call(cpu, 0x2A3B8, (provider,))\n    assert cpu.reg_read(UC_ARM_REG_R0) == 3\n    labels, widths = [], []\n    for index in range(3):\n        call(cpu, 0x2A30C, (provider, index))\n        pointer = cpu.reg_read(UC_ARM_REG_R0)\n        label = bytes(cpu.mem_read(pointer, 32)).split(b'\\0')[0]\n        labels.append(label)\n        call(cpu, 0xCF348, (pointer, 0, 0))\n        widths.append(cpu.reg_read(UC_ARM_REG_R0))\n    maximum = max(8, *widths)\n    call(cpu, 0x52E40, (rect, provider, maximum, 3))\n    geometry = list(struct.unpack('<4i', cpu.mem_read(rect, 16)))\n    cases = []\n    for selected in (0, 1, 2, -1):\n        cpu.mem_write(result - 16, b'\\xA5' * 64)\n        cpu.mem_write(cursor - 16, b'\\xA5' * 64)\n        seen = []\n\n        def complete_modal(uc, address, size, unused, seen=seen, selected=selected):\n            if address == 0x02051FC0:\n                descriptor = uc.reg_read(UC_ARM_REG_R0)\n                assert struct.unpack('<I', uc.mem_read(descriptor + 8, 4))[0] == text\n                seen.append(address)\n                # Only the modal input loop is bridged; getter, parsing and\n                # native return/control flow execute without substitution.\n                uc.reg_write(UC_ARM_REG_R0, selected & 0xFFFFFFFF)\n                uc.reg_write(UC_ARM_REG_PC, uc.reg_read(UC_ARM_REG_LR))\n\n        hook = cpu.hook_add(UC_HOOK_CODE, complete_modal)\n        try:\n            executed = call(cpu, 0x2A510, (result, owner, cursor, 0))\n        finally:\n            cpu.hook_del(hook)\n        assert seen == [0x02051FC0] and {0x0202A510, 0x0202A1D8} <= executed\n        state, selection = struct.unpack('<2I', cpu.mem_read(result, 8))\n        assert state == (2 if selected >= 0 else 0)\n        if selected >= 0:\n            assert selection == selected\n        assert struct.unpack('<I', cpu.mem_read(cursor, 4))[0] == len(object_bytes)\n        assert bytes(cpu.mem_read(text - 16, len(object_bytes)+32)) == original\n        assert bytes(cpu.mem_read(result - 16, 16)) == bytes(cpu.mem_read(result + 8, 16)) == b'\\xA5' * 16\n        assert bytes(cpu.mem_read(cursor - 16, 16)) == bytes(cpu.mem_read(cursor + 4, 16)) == b'\\xA5' * 16\n        cases.append({'modal_selection': selected, 'VM_state': state, 'VM_selection_word': selection, 'next_command_delta': len(object_bytes),\n                      'original_dispatch_ABI_and_guards_pass': True})\n    return {'labels': [p.decode('cp932') for p in labels], 'native_width_units': widths,\n            'native_menu_rectangle': geometry, 'minimum_width_units': maximum, 'VM_cases': cases}\n",
  "source_owned_painter_adapter": "def paint(arm,text,style,width,origin):\n    assert sha(arm)==CURRENT_ARM9\n    assert 0<width<=228 and len(text)*6<=width and 0<=origin[0] and origin[0]+width+6<=256 and 0<=origin[1] and origin[1]+12<=36\n    source=SOURCE\n    changes={\n        '    width, height = 48, 20':'    width,height=LOGICAL_WIDTH,12;backing_width,backing_height=256,36;origin_x,origin_y=VIEW_ORIGIN',\n        'header, view, context, string = 0x02450000, 0x02453000, 0x02454000, 0x02455000':'header,view,context,string=0x02450000,0x02460000,0x02461000,0x02462000',\n        '    size = width * height // 2':'    size=backing_width*backing_height//2',\n        \"raw_header = struct.pack('<5I', 4, width // 4, height, 0x02452000 - header, 20)\":\"raw_header=struct.pack('<5I',4,backing_width//4,backing_height,0x02459000-header,20)\",\n        'call(cpu, 0xD3AFC, (view, header, 0, 0))':'call(cpu,0xD3AFC,(view,header,origin_x,origin_y))',\n        '    x, y = (width - len(text) * 6) // 2, 4':'    x,y=origin_x+(width-len(text)*6)//2,origin_y',\n        '    expected = bytearray(width * height)':'    expected=bytearray(backing_width*backing_height)',\n        'expected[(y + yy) * width + x + index * 6 + xx]':'expected[(y+yy+1)*backing_width+x+index*6+xx]',\n        'visible_center_twice = 2 * x + len(visible) * 6':'visible_center_twice=2*(x-origin_x)+len(visible)*6',\n        \"    return pixels, {'text': text.decode(), 'native_origin': [x, y],\":\"    whole=pixels;pixels=bytes(whole[(origin_y+yy)*backing_width+origin_x+xx] for yy in range(height) for xx in range(width))\\n    return pixels, {'backing_width':backing_width,'backing_height':backing_height,'backing_plane_sha256':sha(whole),'logical_width_px':width,'logical_height_px':height,'source_view_origin':list(VIEW_ORIGIN),'extra_flush_stays_within_physical_backing':True,'storage_padding_all_blank':all(not p for i,p in enumerate(whole) if not(origin_x<=i%backing_width<origin_x+width and origin_y<=i//backing_width<origin_y+height)),'text':text.decode(),'native_origin':[x-origin_x,y-origin_y],'physical_native_origin':[x,y],\"\n    }\n    for a,b in changes.items():assert source.count(a)==1,a;source=source.replace(a,b)\n    env={**original.__dict__,'LOGICAL_WIDTH':width,'VIEW_ORIGIN':origin,'sha':sha};exec(compile(source,__file__+'::native-full-backing-logical-menu-view','exec'),env);pixels,proof=env['paint'](arm,text,style);proof['source_owned_adapter_sha256']=sha(source.encode());return pixels,proof\n",
